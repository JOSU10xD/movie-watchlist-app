platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

require File.join(__dir__, 'Flutter', 'podhelper.rb')

target 'Runner' do
  # Use frameworks without static linkage for Swift plugin compatibility
  use_frameworks!          # Remove :linkage => :static
  use_modular_headers!      # Keep modular headers for plugin compatibility

  install_all_flutter_pods(File.dirname(File.realpath(__FILE__)))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Exclude arm64 for simulator to fix M1/M2 builds
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      # Required for building Swift-based plugins
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      # Force Swift version for all pods
      config.build_settings['SWIFT_VERSION'] = '5.0'
    end
  end
end
